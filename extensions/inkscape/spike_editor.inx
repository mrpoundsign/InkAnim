<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Spike: Motion Editor</name>
  <id>com.mrpoundsign.inkanim.spike_editor</id>
  <effect needs-live-preview="false" implements-custom-gui="true">
    <object-type>all</object-type>
    <effects-menu><submenu name="InkAnim"/></effects-menu>
  </effect>
  <script>
    <command location="inx">bin/inkanim-ext.exe</command>
  </script>
</inkscape-extension>
